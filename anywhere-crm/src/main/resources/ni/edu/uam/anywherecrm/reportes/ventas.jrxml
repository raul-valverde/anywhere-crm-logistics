<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports
http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="ventas" pageWidth="595" pageHeight="842"
              columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20"
              bottomMargin="20">
    <!-- Rango de fechas del reporte -->
    <parameter name="DESDE" class="java.lang.String"/>
    <parameter name="HASTA" class="java.lang.String"/>
    <!-- Una fila por factura -->
    <field name="factura" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="vendedor" class="java.lang.String"/>
    <field name="total" class="java.lang.Double"/>
    <!-- Jasper suma el total de todas las filas -->
    <variable name="TOTAL_GENERAL" class="java.lang.Double"
              calculation="Sum">
        <variableExpression><![CDATA[$F{total}]]></variableExpression>
    </variable>
    <title>
        <band height="70">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement>
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Anywhere CRM Logistics]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="555" height="22"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Reporte de ventas del " + $P{DESDE} + " al " + $P{HASTA}]]></textFieldExpression>
            </textField>
        </band>
    </title>
    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="70"
                               height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/>
                </textElement>
                <text><![CDATA[Factura]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="70" y="0" width="90"
                               height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="160" y="0" width="190"
                               height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/>
                </textElement>
                <text><![CDATA[Cliente]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="350" y="0" width="105"
                               height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/>
                </textElement>
                <text><![CDATA[Vendedor]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="455" y="0" width="100"
                               height="22" backcolor="#E3F2FD"/>
                <textElement textAlignment="Right"
                             verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Total ($)]]></text>
            </staticText>
        </band>
    </columnHeader>
    <detail>
        <band height="20">
            <textField>
                <reportElement x="0" y="0" width="70" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{factura}]]>
                </textFieldExpression>
            </textField>
            <textField>
                <reportElement x="70" y="0" width="90" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{fecha}]]>
                </textFieldExpression>
            </textField>
            <textField>
                <reportElement x="160" y="0" width="190" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{cliente}]]>
                </textFieldExpression>
            </textField>
            <textField>
                <reportElement x="350" y="0" width="105" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{vendedor}]]>
                </textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement x="455" y="0" width="100" height="20"/>
                <textElement textAlignment="Right"
                             verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{total}]]>
                </textFieldExpression>
            </textField>
        </band>
    </detail>
    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="355" y="0" width="200" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]>
                </textFieldExpression>
            </textField>
        </band>
    </pageFooter>
    <summary>
        <band height="40">
            <textField>
                <reportElement x="0" y="10" width="300" height="22"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Facturas: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="335" y="10" width="120" height="22"/>
                <textElement textAlignment="Right">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Total vendido ($)]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="455" y="10" width="100" height="22"/>
                <textElement textAlignment="Right">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{TOTAL_GENERAL} == null ? 0.0: $V{TOTAL_GENERAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>

