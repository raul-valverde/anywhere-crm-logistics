<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import ni.edu.uam.anywherecrm.ui.DynamicIslandNav?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.anywherecrm.controller.DespachosController"
            stylesheets="@styles.css" styleClass="app-shell"
            prefWidth="1280" prefHeight="800">

    <!-- Capa base: contenido del módulo (se anima con FadeTransition al navegar) -->
    <ScrollPane fitToWidth="true" fitToHeight="true" focusTraversable="false" styleClass="content-scroll, content-layer">
        <VBox styleClass="module-root" spacing="14">

            <!-- Encabezado -->
            <VBox spacing="2" styleClass="module-header">
                <Label text="Menú principal  ›  Despachos" styleClass="breadcrumb"/>
                <Label text="Despachos" styleClass="screen-title"/>
                <Label text="Entregas a domicilio, retiros en bodega y rutas de reparto" styleClass="screen-subtitle"/>
            </VBox>

            <!-- Paso 1 -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <Label text="1" styleClass="step-badge"/>
                <Label text="Facturas sin despacho" styleClass="section-title"/>
            </HBox>
            <TableView fx:id="tablaFacturas" prefHeight="180" minHeight="160">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colFacId" text="Factura" prefWidth="70"/>
                    <TableColumn fx:id="colFacFecha" text="Fecha" prefWidth="100"/>
                    <TableColumn fx:id="colFacCliente" text="Cliente" prefWidth="250"/>
                    <TableColumn fx:id="colFacTotal" text="Total ($)" prefWidth="100"/>
                </columns>
            </TableView>

            <!-- Paso 2 -->
            <VBox styleClass="card" spacing="12">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="2" styleClass="step-badge"/>
                    <Label text="Crear el despacho de la factura seleccionada" styleClass="section-title"/>
                </HBox>
                <HBox spacing="10" alignment="BOTTOM_LEFT">
                    <VBox spacing="4">
                        <Label text="Tipo de despacho" styleClass="field-label"/>
                        <ComboBox fx:id="cbTipo" prefWidth="130"/>
                    </VBox>
                    <VBox spacing="4" HBox.hgrow="ALWAYS">
                        <Label text="Dirección de entrega" styleClass="field-label"/>
                        <TextField fx:id="txtDireccion" promptText="Dirección (ej: Metrocentro, Managua)" prefWidth="280"/>
                    </VBox>
                    <Button fx:id="btnUbicar" text="Ubicar" onAction="#handleUbicar"/>
                    <!-- Estado de la ubicación, a la par del botón Ubicar -->
                    <Label fx:id="lblUbicacion" text="Sin ubicar" styleClass="badge-soft" minWidth="80" maxWidth="240"/>
                    <VBox spacing="4">
                        <Label text="Repartidor" styleClass="field-label"/>
                        <ComboBox fx:id="cbRepartidor" promptText="Repartidor" prefWidth="160"/>
                    </VBox>
                    <VBox spacing="4">
                        <Label text="Fecha de despacho" styleClass="field-label"/>
                        <DatePicker fx:id="dpFecha" prefWidth="150"/>
                    </VBox>
                    <Button text="Crear despacho" onAction="#handleCrearDespacho" styleClass="btn-success"/>
                </HBox>
            </VBox>

            <!-- Paso 3 -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox.margin><Insets top="4"/></VBox.margin>
                <Label text="3" styleClass="step-badge"/>
                <VBox spacing="1">
                    <Label text="Despachos" styleClass="section-title"/>
                    <Label text="Ctrl + clic para elegir varios y armar una ruta" styleClass="section-caption"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" onAction="#cargarDatos"/>
                <Button text="Ver mapa" onAction="#handleVerMapa"/>
                <Button text="Avanzar estado" onAction="#handleAvanzarEstado" styleClass="btn-warning"/>
                <Button text="Eliminar" onAction="#handleEliminarDespacho" styleClass="btn-danger"/>
                <Button fx:id="btnArmarRuta" text="Armar ruta" onAction="#handleArmarRuta" styleClass="btn-primary"/>
            </HBox>
            <TableView fx:id="tablaDespachos" VBox.vgrow="ALWAYS" prefHeight="300" minHeight="260">
                <VBox.margin><Insets bottom="6"/></VBox.margin>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colDesId" text="N.º" prefWidth="45"/>
                    <TableColumn fx:id="colDesFactura" text="Factura" prefWidth="65"/>
                    <TableColumn fx:id="colDesCliente" text="Cliente" prefWidth="160"/>
                    <TableColumn fx:id="colDesTipo" text="Tipo" prefWidth="65"/>
                    <TableColumn fx:id="colDesEstado" text="Estado" prefWidth="90"/>
                    <TableColumn fx:id="colDesFecha" text="Fecha" prefWidth="90"/>
                    <TableColumn fx:id="colDesRepartidor" text="Repartidor" prefWidth="90"/>
                    <TableColumn fx:id="colDesDireccion" text="Dirección" prefWidth="170"/>
                    <TableColumn fx:id="colDesRuta" text="Ruta" prefWidth="170"/>
                </columns>
            </TableView>
        </VBox>
    </ScrollPane>

    <!-- Capa flotante: Isla Dinámica (no captura clics fuera de la cápsula) -->
    <DynamicIslandNav activo="DESPACHOS"/>
</StackPane>
