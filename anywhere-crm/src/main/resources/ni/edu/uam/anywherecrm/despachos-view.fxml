<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.anywherecrm.controller.DespachosController"
      spacing="10" style="-fx-padding: 20;">
    <Label text="Despachos" style="-fx-font-size: 18px; -fx-font-weight:
bold;"/>
    <Label text="Facturas sin despacho" style="-fx-font-weight: bold;"/>
    <TableView fx:id="tablaFacturas" prefHeight="150">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colFacId" text="Factura" prefWidth="70"/>
            <TableColumn fx:id="colFacFecha" text="Fecha" prefWidth="100"/>
            <TableColumn fx:id="colFacCliente" text="Cliente"
                         prefWidth="250"/>
            <TableColumn fx:id="colFacTotal" text="Total ($)"
                         prefWidth="100"/>
        </columns>
    </TableView>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="cbTipo" prefWidth="100"/>
        <TextField fx:id="txtDireccion" promptText="Dirección de entrega"
                   prefWidth="220"/>
        <ComboBox fx:id="cbRepartidor" promptText="Repartidor"
                  prefWidth="140"/>
        <TextField fx:id="txtRuta" promptText="Ruta (opcional)"
                   prefWidth="140"/>
        <Button fx:id="btnCalcularRuta" text="Calcular ruta" onAction="#handleCalcularRuta"/>
        <Button text="Ver mapa" onAction="#handleVerMapa"/>
        <DatePicker fx:id="dpFecha" prefWidth="130"/>
        <Button text="Crear despacho" onAction="#handleCrearDespacho"
                style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight:
bold;"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Despachos creados" style="-fx-font-weight: bold;"/>
        <Button text="Avanzar estado" onAction="#handleAvanzarEstado"
                style="-fx-background-color: #F57C00; -fx-text-fill: white;"/>
        <Button text="Actualizar" onAction="#cargarDatos"/>
    </HBox>
    <TableView fx:id="tablaDespachos" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colDesId" text="N.º" prefWidth="45"/>
            <TableColumn fx:id="colDesFactura" text="Factura"
                         prefWidth="70"/>
            <TableColumn fx:id="colDesCliente" text="Cliente"
                         prefWidth="170"/>
            <TableColumn fx:id="colDesTipo" text="Tipo" prefWidth="70"/>
            <TableColumn fx:id="colDesEstado" text="Estado" prefWidth="90"/>
            <TableColumn fx:id="colDesFecha" text="Fecha" prefWidth="95"/>
            <TableColumn fx:id="colDesRepartidor" text="Repartidor"
                         prefWidth="100"/>
            <TableColumn fx:id="colDesDireccion" text="Dirección"
                         prefWidth="180"/>
            <TableColumn fx:id="colDesRuta" text="Ruta" prefWidth="140"/>
        </columns>
    </TableView>
</VBox>

