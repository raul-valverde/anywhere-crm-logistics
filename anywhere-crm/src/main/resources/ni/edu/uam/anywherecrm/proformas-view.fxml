<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import ni.edu.uam.anywherecrm.ui.DynamicIslandNav?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.anywherecrm.controller.ProformasController"
            stylesheets="@styles.css" styleClass="app-shell"
            prefWidth="1280" prefHeight="800">

    <!-- Capa base: contenido del módulo (se anima con FadeTransition al navegar) -->
    <ScrollPane fitToWidth="true" fitToHeight="true" focusTraversable="false" styleClass="content-scroll, content-layer">
        <VBox styleClass="module-root" spacing="16">

            <!-- Encabezado -->
            <VBox spacing="2" styleClass="module-header">
                <Label text="Menú principal  ›  Proformas" styleClass="breadcrumb"/>
                <Label text="Proformas" styleClass="screen-title"/>
                <Label text="Cotizaciones de venta: verifica stock, anula o factura" styleClass="screen-subtitle"/>
            </VBox>

            <!-- Filtros y acciones -->
            <HBox styleClass="card" spacing="10" alignment="CENTER_LEFT">
                <Label text="Estado:" styleClass="field-label"/>
                <ComboBox fx:id="cbEstado" onAction="#cargarProformas" prefWidth="170"/>
                <Region styleClass="toolbar-separator"/>
                <Button text="Verificar stock" onAction="#handleVerificarStock"/>
                <Button text="Anular proforma" onAction="#handleAnular" styleClass="btn-danger"/>
                <Button text="Facturar" onAction="#handleFacturar" styleClass="btn-primary"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="+ Nueva proforma" onAction="#handleNuevaProforma" styleClass="btn-success"/>
            </HBox>

            <!-- Listado: altura para 6 filas completas (38 cabecera + 6 x 34) -->
            <TableView fx:id="tablaProformas" VBox.vgrow="ALWAYS" prefHeight="300" minHeight="250">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110"/>
                    <TableColumn fx:id="colMonto" text="Monto ($)" prefWidth="110"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
                </columns>
            </TableView>

            <HBox spacing="10" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Productos de la proforma" styleClass="section-title"/>
                    <Label text="Selecciona una proforma para ver su detalle" styleClass="section-caption"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="lblTotal" text="Total: $0.00" styleClass="total-label"/>
            </HBox>

            <TableView fx:id="tablaDetalles" VBox.vgrow="ALWAYS" prefHeight="230" minHeight="180">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="220"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="90"/>
                    <TableColumn fx:id="colPrecio" text="Precio ($)" prefWidth="100"/>
                    <TableColumn fx:id="colSubtotal" text="Subtotal ($)" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </ScrollPane>

    <!-- Capa flotante: Isla Dinámica (no captura clics fuera de la cápsula) -->
    <DynamicIslandNav activo="PROFORMAS"/>
</StackPane>
