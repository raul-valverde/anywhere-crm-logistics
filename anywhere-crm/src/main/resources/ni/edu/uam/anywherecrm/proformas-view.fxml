<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.anywherecrm.controller.ProformasController"
      spacing="10" style="-fx-padding: 20;">
    <Label text="Proformas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>
    <HBox spacing="10">
        <Label text="Estado:"/>
        <ComboBox fx:id="cbEstado" onAction="#cargarProformas"/>
        <Button text="Anular proforma" onAction="#handleAnular" style="-fx-background-color: #E53935; -fx-text-fill: white;"/>
        <Button text="Verificar stock" onAction="#handleVerificarStock"/>
        <Button text="Facturar" onAction="#handleFacturar" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>
    <TableView fx:id="tablaProformas" prefHeight="220">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="110"/>
            <TableColumn fx:id="colMonto" text="Monto ($)" prefWidth="110"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="110"/>
        </columns>
    </TableView>
    <Label text="Productos de la proforma" style="-fx-font-weight: bold;"/>
    <TableView fx:id="tablaDetalles" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="220"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="90"/>
            <TableColumn fx:id="colPrecio" text="Precio ($)" prefWidth="100"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal ($)" prefWidth="110"/>
        </columns>
    </TableView>
    <Label fx:id="lblTotal" text="Total: $0.00" style="-fx-font-size: 14px; -fx-font-weight: bold;"/>
</VBox>