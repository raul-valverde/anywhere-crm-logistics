<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import ni.edu.uam.anywherecrm.ui.DynamicIslandNav?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.anywherecrm.controller.InventarioController"
            stylesheets="@styles.css" styleClass="app-shell"
            prefWidth="1280" prefHeight="800">

    <!-- Capa base: contenido del módulo (se anima con FadeTransition al navegar) -->
    <ScrollPane fitToWidth="true" fitToHeight="true" focusTraversable="false" styleClass="content-scroll, content-layer">
        <VBox styleClass="module-root" spacing="16">

            <!-- Encabezado -->
            <VBox spacing="2" styleClass="module-header">
                <Label text="Menú principal  ›  Inventario" styleClass="breadcrumb"/>
                <Label text="Gestión de Inventario" styleClass="screen-title"/>
                <Label text="Catálogo de productos, existencias y movimientos de bodega" styleClass="screen-subtitle"/>
            </VBox>

            <!-- Alta de productos -->
            <VBox styleClass="card" spacing="12">
                <Label text="Nuevo producto" styleClass="section-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtNombre" promptText="Nombre del producto" HBox.hgrow="ALWAYS" prefWidth="240"/>
                    <TextField fx:id="txtPrecio" promptText="Precio ($)" prefWidth="120"/>
                    <TextField fx:id="txtStock" promptText="Cantidad Stock" prefWidth="140"/>
                    <ComboBox fx:id="cbCategoria" promptText="Categoría" prefWidth="180"/>
                    <Button text="Guardar Producto" onAction="#handleGuardarProducto" styleClass="btn-success"/>
                    <Button text="PDF de inventario" onAction="#handlePdfInventario" styleClass="btn-primary"/>
                </HBox>
            </VBox>

            <!-- Productos: crece junto con la tabla de movimientos -->
            <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS" prefHeight="250" minHeight="180">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colNombre" text="Producto" prefWidth="250"/>
                    <TableColumn fx:id="colCategoria" text="Categoría" prefWidth="150"/>
                    <TableColumn fx:id="colPrecio" text="Precio ($)" prefWidth="120"/>
                    <TableColumn fx:id="colStock" text="Stock" prefWidth="120"/>
                </columns>
            </TableView>

            <!-- Movimientos de bodega -->
            <VBox styleClass="card" spacing="12">
                <VBox spacing="2">
                    <Label text="Movimientos de bodega" styleClass="section-title"/>
                    <Label text="Selecciona un producto en la tabla de arriba y registra su entrada o salida" styleClass="section-caption"/>
                </VBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtCantidadMov" promptText="Cantidad" prefWidth="140"/>
                    <TextField fx:id="txtMotivo" promptText="Motivo (opcional)" HBox.hgrow="ALWAYS" prefWidth="300"/>
                    <Button text="Registrar entrada" onAction="#handleRegistrarEntrada" styleClass="btn-primary"/>
                    <Button text="Registrar salida" onAction="#handleRegistrarSalida" styleClass="btn-warning"/>
                </HBox>
            </VBox>

            <TableView fx:id="tablaMovimientos" VBox.vgrow="ALWAYS" prefHeight="220" minHeight="170">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colMovFecha" text="Fecha" prefWidth="160"/>
                    <TableColumn fx:id="colMovProducto" text="Producto" prefWidth="180"/>
                    <TableColumn fx:id="colMovTipo" text="Tipo" prefWidth="90"/>
                    <TableColumn fx:id="colMovCantidad" text="Cantidad" prefWidth="80"/>
                    <TableColumn fx:id="colMovMotivo" text="Motivo" prefWidth="180"/>
                </columns>
            </TableView>

            <!-- Reporte Kardex / Movimientos de bodega (JasperReports) -->
            <VBox styleClass="card" spacing="12">
                <VBox spacing="2">
                    <Label text="Reporte de movimientos de bodega / Kardex (JasperReports)" styleClass="section-title"/>
                    <Label text="Elige el rango de fechas y el tipo de movimiento para generar la vista previa (PDF o Excel)" styleClass="section-caption"/>
                </VBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Desde:" styleClass="field-label"/>
                    <DatePicker fx:id="dpMovDesde" prefWidth="160"/>
                    <Label text="Hasta:" styleClass="field-label"/>
                    <DatePicker fx:id="dpMovHasta" prefWidth="160"/>
                    <Label text="Tipo:" styleClass="field-label"/>
                    <ComboBox fx:id="cbTipoMov" prefWidth="150"/>
                    <Button text="Generar reporte" onAction="#handleReporteMovimientos" styleClass="btn-primary"/>
                </HBox>
            </VBox>
        </VBox>
    </ScrollPane>

    <!-- Capa flotante: Isla Dinámica (no captura clics fuera de la cápsula) -->
    <DynamicIslandNav activo="INVENTARIO"/>
</StackPane>
