<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.anywherecrm.controller.InventarioController"
      spacing="10" style="-fx-padding: 20;">

    <Label text="Gestión de Inventario" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <TextField fx:id="txtNombre" promptText="Nombre del producto"/>
        <TextField fx:id="txtPrecio" promptText="Precio ($)"/>
        <TextField fx:id="txtStock" promptText="Cantidad Stock"/>
        <Button text="Guardar Producto" onAction="#handleGuardarProducto" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <TableView fx:id="tablaProductos" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNombre" text="Producto" prefWidth="250"/>
            <TableColumn fx:id="colPrecio" text="Precio ($)" prefWidth="120"/>
            <TableColumn fx:id="colStock" text="Stock" prefWidth="120"/>
        </columns>
    </TableView>
    
    <Label text="Movimientos de bodega (selecciona un producto arriba)" style="-fx-font-weight: bold;"/>

    <HBox spacing="10">
        <TextField fx:id="txtCantidadMov" promptText="Cantidad"/>
        <TextField fx:id="txtMotivo" promptText="Motivo (opcional)"/>
        <Button text="Registrar entrada" onAction="#handleRegistrarEntrada"
                style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
        <Button text="Registrar salida" onAction="#handleRegistrarSalida"
                style="-fx-background-color: #F57C00; -fx-text-fill: white;"/>
    </HBox>

    <TableView fx:id="tablaMovimientos" prefHeight="180">
        <columns>
            <TableColumn fx:id="colMovFecha" text="Fecha" prefWidth="160"/>
            <TableColumn fx:id="colMovProducto" text="Producto" prefWidth="180"/>
            <TableColumn fx:id="colMovTipo" text="Tipo" prefWidth="90"/>
            <TableColumn fx:id="colMovCantidad" text="Cantidad" prefWidth="80"/>
            <TableColumn fx:id="colMovMotivo" text="Motivo" prefWidth="180"/>
        </columns>
    </TableView>
</VBox>


