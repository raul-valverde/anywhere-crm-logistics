<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="despachos" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Estilo condicional según el estado del despacho -->
    <style name="estiloEstado">
        <conditionalStyle>
            <conditionExpression><![CDATA["ENTREGADO".equals($F{estado})]]></conditionExpression>
            <style forecolor="#2E7D32" isBold="true"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["EN_CAMINO".equals($F{estado})]]></conditionExpression>
            <style forecolor="#1565C0" isBold="true"/>
        </conditionalStyle>
        <conditionalStyle>
            <conditionExpression><![CDATA["PENDIENTE".equals($F{estado})]]></conditionExpression>
            <style forecolor="#EF6C00" isBold="true"/>
        </conditionalStyle>
    </style>

    <!-- Parámetros de cabecera -->
    <parameter name="DESDE" class="java.lang.String"/>
    <parameter name="HASTA" class="java.lang.String"/>
    <parameter name="ESTADO_FILTRO" class="java.lang.String"/>

    <!-- Columnas del reporte -->
    <field name="despacho" class="java.lang.String"/>
    <field name="factura" class="java.lang.String"/>
    <field name="cliente" class="java.lang.String"/>
    <field name="tipo" class="java.lang.String"/>
    <field name="repartidor" class="java.lang.String"/>
    <field name="destino" class="java.lang.String"/>
    <field name="fecha" class="java.lang.String"/>
    <field name="estado" class="java.lang.String"/>

    <!-- Contadores automáticos para el resumen final -->
    <variable name="TOTAL_ENTREGADOS" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA["ENTREGADO".equals($F{estado}) ? 1 : 0]]></variableExpression>
    </variable>
    <variable name="TOTAL_PENDIENTES_CAMINO" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA[!"ENTREGADO".equals($F{estado}) ? 1 : 0]]></variableExpression>
    </variable>

    <title>
        <band height="82">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement>
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Anywhere CRM Logistics]]></text>
            </staticText>
            <textField>
                <reportElement x="0" y="35" width="555" height="22"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Reporte de despachos y entregas del " + $P{DESDE} + " al " + $P{HASTA}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="59" width="555" height="18"/>
                <textFieldExpression><![CDATA["Filtro de estado: " + $P{ESTADO_FILTRO}]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="48" height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Desp. #]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="48" y="0" width="48" height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Fact. #]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="96" y="0" width="104" height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Cliente]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="200" y="0" width="46" height="22" backcolor="#E3F2FD"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Tipo]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="246" y="0" width="72" height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Repartidor]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="318" y="0" width="112" height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Dirección / Ruta]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="430" y="0" width="60" height="22" backcolor="#E3F2FD"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Fecha]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="490" y="0" width="65" height="22" backcolor="#E3F2FD"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="9" isBold="true"/>
                </textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="24">
            <textField>
                <reportElement x="0" y="0" width="48" height="24"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{despacho}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="48" y="0" width="48" height="24"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{factura}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="96" y="0" width="104" height="24"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{cliente}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="200" y="0" width="46" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{tipo}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="246" y="0" width="72" height="24"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{repartidor}]]></textFieldExpression>
            </textField>
            <textField isStretchWithOverflow="true">
                <reportElement x="318" y="0" width="112" height="24"/>
                <textElement verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{destino}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="430" y="0" width="60" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{fecha}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="estiloEstado" x="490" y="0" width="65" height="24"/>
                <textElement textAlignment="Center" verticalAlignment="Middle">
                    <font size="8"/>
                </textElement>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="355" y="0" width="200" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="45">
            <textField>
                <reportElement x="0" y="12" width="180" height="22"/>
                <textElement>
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Total despachos: " + $V{REPORT_COUNT}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="180" y="12" width="375" height="22"/>
                <textElement textAlignment="Right">
                    <font size="11" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Entregados: " + ($V{TOTAL_ENTREGADOS} == null ? 0 : $V{TOTAL_ENTREGADOS}) + "  |  Pendientes / En camino: " + ($V{TOTAL_PENDIENTES_CAMINO} == null ? 0 : $V{TOTAL_PENDIENTES_CAMINO})]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>