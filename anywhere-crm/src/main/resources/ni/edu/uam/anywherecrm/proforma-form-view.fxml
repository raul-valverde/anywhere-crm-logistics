<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.anywherecrm.controller.ProformaFormController"
      stylesheets="@styles.css" styleClass="module-root, modal-root" spacing="18">

    <!-- Encabezado -->
    <VBox spacing="2" styleClass="module-header">
        <Label text="Nueva proforma" styleClass="screen-title"/>
        <Label text="Elige el cliente y agrega los productos a cotizar" styleClass="screen-subtitle"/>
    </VBox>

    <!-- Cliente y productos -->
    <VBox styleClass="card" spacing="14">
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Cliente:" styleClass="field-label" minWidth="70"/>
            <ComboBox fx:id="cbCliente" promptText="Elige un cliente" prefWidth="360"/>
        </HBox>
        <HBox spacing="10" alignment="CENTER_LEFT">
            <Label text="Producto:" styleClass="field-label" minWidth="70"/>
            <ComboBox fx:id="cbProducto" promptText="Elige un producto" prefWidth="360"/>
            <TextField fx:id="txtCantidad" promptText="Cantidad" prefWidth="110" onAction="#handleAgregar"/>
            <Button text="Agregar" onAction="#handleAgregar" styleClass="btn-primary"/>
            <Button text="Quitar" onAction="#handleQuitar"/>
        </HBox>
    </VBox>

    <TableView fx:id="tablaLineas" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="250"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="90"/>
            <TableColumn fx:id="colPrecio" text="Precio ($)" prefWidth="100"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal ($)" prefWidth="110"/>
        </columns>
    </TableView>

    <!-- Total y confirmación -->
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label fx:id="lblTotal" text="Total: $0.00" styleClass="total-label"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Cancelar" onAction="#handleCancelar"/>
        <Button text="Guardar proforma" onAction="#handleGuardar" styleClass="btn-success"/>
    </HBox>
</VBox>
