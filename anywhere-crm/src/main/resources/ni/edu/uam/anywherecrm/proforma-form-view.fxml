<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.anywherecrm.controller.ProformaFormController"
      spacing="10" style="-fx-padding: 20;">
    <Label text="Nueva proforma" style="-fx-font-size: 18px; -fx-font-weight:
bold;"/>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Cliente:"/>
        <ComboBox fx:id="cbCliente" promptText="Elige un cliente"
                  prefWidth="300"/>
    </HBox>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <ComboBox fx:id="cbProducto" promptText="Elige un producto"
                  prefWidth="330"/>
        <TextField fx:id="txtCantidad" promptText="Cantidad" prefWidth="90"
                   onAction="#handleAgregar"/>
        <Button text="Agregar" onAction="#handleAgregar" style="-fx-background-color: #1976D2; -fx-text-fill: white;"/>
        <Button text="Quitar" onAction="#handleQuitar"/>
    </HBox>
    <TableView fx:id="tablaLineas" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colProducto" text="Producto"
                         prefWidth="250"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="90"/>
            <TableColumn fx:id="colPrecio" text="Precio ($)"
                         prefWidth="100"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal ($)"
                         prefWidth="110"/>
        </columns>
    </TableView>
    <HBox spacing="10" alignment="CENTER_RIGHT">
        <Label fx:id="lblTotal" text="Total: $0.00" style="-fx-font-size:
14px; -fx-font-weight: bold;"/>
        <Button text="Guardar proforma" onAction="#handleGuardar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Cancelar" onAction="#handleCancelar"/>
    </HBox>
</VBox>

