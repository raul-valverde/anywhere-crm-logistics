<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports"
              xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
              xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd"
              name="inventario" pageWidth="595" pageHeight="842" columnWidth="555"
              leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">

    <!-- Estilo condicional: la fila sale en rojo cuando el stock está BAJO -->
    <style name="filaInventario">
        <conditionalStyle>
            <conditionExpression><![CDATA["BAJO".equals($F{estado})]]></conditionExpression>
            <style forecolor="#D32F2F" isBold="true"/>
        </conditionalStyle>
    </style>

    <parameter name="FECHA" class="java.lang.String"/>
    <parameter name="STOCK_MINIMO" class="java.lang.Integer"/>

    <field name="producto" class="java.lang.String"/>
    <field name="categoria" class="java.lang.String"/>
    <field name="precio" class="java.lang.Double"/>
    <field name="stock" class="java.lang.Integer"/>
    <field name="valor" class="java.lang.Double"/>
    <field name="estado" class="java.lang.String"/>

    <!-- Totales que calcula Jasper -->
    <variable name="VALOR_TOTAL" class="java.lang.Double" calculation="Sum">
        <variableExpression><![CDATA[$F{valor}]]></variableExpression>
    </variable>
    <variable name="PRODUCTOS_BAJOS" class="java.lang.Integer" calculation="Sum">
        <variableExpression><![CDATA["BAJO".equals($F{estado}) ? 1 : 0]]></variableExpression>
    </variable>

    <title>
        <band height="80">
            <staticText>
                <reportElement x="0" y="0" width="555" height="30"/>
                <textElement>
                    <font size="20" isBold="true"/>
                </textElement>
                <text><![CDATA[Anywhere CRM Logistics]]></text>
            </staticText>
            <staticText>
                <reportElement x="0" y="35" width="300" height="22"/>
                <textElement>
                    <font size="14" isBold="true"/>
                </textElement>
                <text><![CDATA[Reporte de inventario]]></text>
            </staticText>
            <textField>
                <reportElement x="300" y="35" width="255" height="22"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Fecha: " + $P{FECHA}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement x="0" y="58" width="555" height="18"/>
                <textFieldExpression><![CDATA["En rojo: productos con menos de " + $P{STOCK_MINIMO} + " unidades"]]></textFieldExpression>
            </textField>
        </band>
    </title>

    <columnHeader>
        <band height="22">
            <staticText>
                <reportElement mode="Opaque" x="0" y="0" width="170" height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Producto]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="170" y="0" width="110" height="22" backcolor="#E3F2FD"/>
                <textElement verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Categoría]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="280" y="0" width="75" height="22" backcolor="#E3F2FD"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Precio ($)]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="355" y="0" width="60" height="22" backcolor="#E3F2FD"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Stock]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="415" y="0" width="90" height="22" backcolor="#E3F2FD"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Valor ($)]]></text>
            </staticText>
            <staticText>
                <reportElement mode="Opaque" x="505" y="0" width="50" height="22" backcolor="#E3F2FD"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"><font isBold="true"/></textElement>
                <text><![CDATA[Estado]]></text>
            </staticText>
        </band>
    </columnHeader>

    <detail>
        <band height="20">
            <textField>
                <reportElement style="filaInventario" x="0" y="0" width="170" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{producto}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="filaInventario" x="170" y="0" width="110" height="20"/>
                <textElement verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{categoria}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement style="filaInventario" x="280" y="0" width="75" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{precio}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="filaInventario" x="355" y="0" width="60" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{stock}]]></textFieldExpression>
            </textField>
            <textField pattern="#,##0.00">
                <reportElement style="filaInventario" x="415" y="0" width="90" height="20"/>
                <textElement textAlignment="Right" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{valor}]]></textFieldExpression>
            </textField>
            <textField>
                <reportElement style="filaInventario" x="505" y="0" width="50" height="20"/>
                <textElement textAlignment="Center" verticalAlignment="Middle"/>
                <textFieldExpression><![CDATA[$F{estado}]]></textFieldExpression>
            </textField>
        </band>
    </detail>

    <pageFooter>
        <band height="20">
            <textField>
                <reportElement x="355" y="0" width="200" height="20"/>
                <textElement textAlignment="Right"/>
                <textFieldExpression><![CDATA["Página " + $V{PAGE_NUMBER}]]></textFieldExpression>
            </textField>
        </band>
    </pageFooter>

    <summary>
        <band height="50">
            <textField>
                <reportElement x="0" y="10" width="300" height="20"/>
                <textElement>
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA["Productos: " + $V{REPORT_COUNT} + " | Con stock bajo: " + $V{PRODUCTOS_BAJOS}]]></textFieldExpression>
            </textField>
            <staticText>
                <reportElement x="300" y="10" width="155" height="20"/>
                <textElement textAlignment="Right">
                    <font size="12" isBold="true"/>
                </textElement>
                <text><![CDATA[Valor total en bodega ($)]]></text>
            </staticText>
            <textField pattern="#,##0.00">
                <reportElement x="455" y="10" width="100" height="20"/>
                <textElement textAlignment="Right">
                    <font size="12" isBold="true"/>
                </textElement>
                <textFieldExpression><![CDATA[$V{VALOR_TOTAL} == null ? 0.0 : $V{VALOR_TOTAL}]]></textFieldExpression>
            </textField>
        </band>
    </summary>
</jasperReport>