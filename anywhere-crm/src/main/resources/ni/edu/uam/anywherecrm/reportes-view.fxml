<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import ni.edu.uam.anywherecrm.ui.DynamicIslandNav?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
           fx:controller="ni.edu.uam.anywherecrm.controller.ReportesController"
           stylesheets="@styles.css" styleClass="app-shell"
           prefWidth="1280" prefHeight="800">

    <!-- Capa base: contenido del módulo (se anima con FadeTransition al navegar) -->
    <ScrollPane fitToWidth="true" fitToHeight="true" focusTraversable="false" styleClass="content-scroll, content-layer">
        <VBox styleClass="module-root" spacing="18">

            <!-- Encabezado -->
            <VBox spacing="2" styleClass="module-header">
                <Label text="Menú principal  ›  Reportes" styleClass="breadcrumb"/>
                <Label text="Reportes y Consultas HQL de Negocio" styleClass="screen-title"/>
                <Label text="Indicadores de ventas y exportación de reportes en PDF" styleClass="screen-subtitle"/>
            </VBox>

            <!-- Consultas HQL lado a lado -->
            <HBox spacing="18" VBox.vgrow="ALWAYS" minHeight="260">
                <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS" prefWidth="400">
                    <VBox spacing="2">
                        <Label text="Consulta HQL 1: Top Productos Más Vendidos" styleClass="section-title"/>
                        <Label text="Productos con mayor cantidad vendida" styleClass="section-caption"/>
                    </VBox>
                    <ListView fx:id="listTopProductos" styleClass="result-list" prefHeight="160" VBox.vgrow="ALWAYS"/>
                </VBox>
                <VBox styleClass="card" spacing="12" HBox.hgrow="ALWAYS" prefWidth="400">
                    <VBox spacing="2">
                        <Label text="Consulta HQL 2: Total Vendido por Vendedor" styleClass="section-title"/>
                        <Label text="Órdenes completadas agrupadas por vendedor" styleClass="section-caption"/>
                    </VBox>
                    <ListView fx:id="listVentasVendedor" styleClass="result-list" prefHeight="160" VBox.vgrow="ALWAYS"/>
                </VBox>
            </HBox>

            <!-- Reporte PDF Ventas -->
            <VBox styleClass="card" spacing="12">
                <VBox spacing="2">
                    <Label text="Reporte de ventas en PDF (JasperReports)" styleClass="section-title"/>
                    <Label text="Elige el rango de fechas y genera la vista previa del reporte" styleClass="section-caption"/>
                </VBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Desde:" styleClass="field-label"/>
                    <DatePicker fx:id="dpDesde" prefWidth="160"/>
                    <Label text="Hasta:" styleClass="field-label"/>
                    <DatePicker fx:id="dpHasta" prefWidth="160"/>
                    <Button text="PDF de ventas" onAction="#handlePdfVentas" styleClass="btn-primary"/>
                </HBox>
            </VBox>

            <!-- Reporte PDF Despachos y Entregas Logísticas -->
            <VBox styleClass="card" spacing="12">
                <VBox spacing="2">
                    <Label text="Reporte de despachos y entregas logísticas (JasperReports)" styleClass="section-title"/>
                    <Label text="Elige el rango de fechas y el estado para generar la vista previa (PDF o Excel)" styleClass="section-caption"/>
                </VBox>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label text="Desde:" styleClass="field-label"/>
                    <DatePicker fx:id="dpDespachoDesde" prefWidth="160"/>
                    <Label text="Hasta:" styleClass="field-label"/>
                    <DatePicker fx:id="dpDespachoHasta" prefWidth="160"/>
                    <Label text="Estado:" styleClass="field-label"/>
                    <ComboBox fx:id="cbEstadoDespacho" prefWidth="150"/>
                    <Button text="Generar reporte" onAction="#handlePdfDespachos" styleClass="btn-primary"/>
                </HBox>
            </VBox>

        </VBox>
    </ScrollPane>

    <!-- Capa flotante: Isla Dinámica (no captura clics fuera de la cápsula) -->
    <DynamicIslandNav activo="REPORTES"/>
</StackPane>
