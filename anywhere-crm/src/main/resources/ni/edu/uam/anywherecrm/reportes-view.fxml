<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>





<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.anywherecrm.controller.ReportesController"
      spacing="15" style="-fx-padding: 20;">

    <Label text="Reportes y Consultas HQL de Negocio" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <Label text="Consulta HQL 1: Top Productos Más Vendidos" style="-fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
    <ListView fx:id="listTopProductos" prefHeight="160"/>

    <Label text="Consulta HQL 2: Total Vendido por Vendedor (Órdenes Completadas)" style="-fx-font-weight: bold; -fx-text-fill: #1976D2;"/>
    <ListView fx:id="listVentasVendedor" prefHeight="160"/>
</VBox>
