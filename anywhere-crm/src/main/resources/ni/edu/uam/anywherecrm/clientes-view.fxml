<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import ni.edu.uam.anywherecrm.ui.DynamicIslandNav?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.anywherecrm.controller.ClientesController"
            stylesheets="@styles.css" styleClass="app-shell"
            prefWidth="1280" prefHeight="800">

    <!-- Capa base: contenido del módulo (se anima con FadeTransition al navegar) -->
    <ScrollPane fitToWidth="true" fitToHeight="true" focusTraversable="false" styleClass="content-scroll, content-layer">
        <VBox styleClass="module-root" spacing="18">

            <!-- Encabezado -->
            <VBox spacing="2" styleClass="module-header">
                <Label text="Menú principal  ›  Clientes" styleClass="breadcrumb"/>
                <Label text="Gestión de Clientes" styleClass="screen-title"/>
                <Label text="Registra, actualiza y busca la cartera de clientes" styleClass="screen-subtitle"/>
            </VBox>

            <!-- Formulario y acciones -->
            <VBox styleClass="card" spacing="12">
                <Label text="Datos del cliente" styleClass="section-title"/>
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <TextField fx:id="txtNombre" promptText="Nombre" HBox.hgrow="ALWAYS" prefWidth="240"/>
                    <TextField fx:id="txtTelefono" promptText="Teléfono" HBox.hgrow="ALWAYS" prefWidth="170"/>
                    <TextField fx:id="txtEmail" promptText="Email" HBox.hgrow="ALWAYS" prefWidth="240"/>
                    <Button text="Guardar" onAction="#handleGuardar" styleClass="btn-success"/>
                    <Button text="Nuevo" onAction="#limpiarFormulario"/>
                    <Button text="Eliminar" onAction="#handleEliminar" styleClass="btn-danger"/>
                </HBox>
            </VBox>

            <!-- Búsqueda -->
            <HBox spacing="10" alignment="CENTER_LEFT">
                <TextField fx:id="txtBuscar" promptText="Buscar por nombre" onAction="#handleBuscar" prefWidth="320"/>
                <Button text="Buscar" onAction="#handleBuscar" styleClass="btn-dark"/>
            </HBox>

            <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS" minHeight="260">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
                    <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
                    <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="130"/>
                    <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
                </columns>
            </TableView>
        </VBox>
    </ScrollPane>

    <!-- Capa flotante: Isla Dinámica (no captura clics fuera de la cápsula) -->
    <DynamicIslandNav activo="CLIENTES"/>
</StackPane>
