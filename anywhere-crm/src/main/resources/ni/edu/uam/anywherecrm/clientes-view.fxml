<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.anywherecrm.controller.ClientesController"
      spacing="10" style="-fx-padding: 20;">

    <Label text="Gestión de Clientes" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <TextField fx:id="txtNombre" promptText="Nombre"/>
        <TextField fx:id="txtTelefono" promptText="Teléfono"/>
        <TextField fx:id="txtEmail" promptText="Email"/>
        <Button text="Guardar" onAction="#handleGuardar" style="-fx-background-color: #4CAF50; -fx-text-fill: white; -fx-font-weight: bold;"/>
        <Button text="Nuevo" onAction="#limpiarFormulario"/>
        <Button text="Eliminar" onAction="#handleEliminar" style="-fx-background-color: #E53935; -fx-text-fill: white;"/>
    </HBox>

    <HBox spacing="10">
        <TextField fx:id="txtBuscar" promptText="Buscar por nombre" onAction="#handleBuscar"/>
        <Button text="Buscar" onAction="#handleBuscar"/>
    </HBox>

    <TableView fx:id="tablaClientes" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="colId" text="ID" prefWidth="50"/>
            <TableColumn fx:id="colNombre" text="Nombre" prefWidth="220"/>
            <TableColumn fx:id="colTelefono" text="Teléfono" prefWidth="130"/>
            <TableColumn fx:id="colEmail" text="Email" prefWidth="220"/>
        </columns>
    </TableView>
</VBox>