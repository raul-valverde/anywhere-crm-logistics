<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
      fx:controller="ni.edu.uam.anywherecrm.controller.FacturasController"
      spacing="10" style="-fx-padding: 20;">

    <Label text="Facturas" style="-fx-font-size: 18px; -fx-font-weight: bold;"/>

    <HBox spacing="10">
        <Button text="Actualizar" onAction="#cargarFacturas"/>
        <Button text="Generar PDF" onAction="#handleGenerarPdf" style="-fx-background-color: #1976D2; -fx-text-fill: white; -fx-font-weight: bold;"/>
    </HBox>

    <TableView fx:id="tablaFacturas" prefHeight="220">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colId" text="N.º" prefWidth="50"/>
            <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
            <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
            <TableColumn fx:id="colVendedor" text="Vendedor" prefWidth="120"/>
            <TableColumn fx:id="colTotal" text="Total ($)" prefWidth="100"/>
            <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
        </columns>
    </TableView>

    <Label text="Productos de la factura" style="-fx-font-weight: bold;"/>
    <TableView fx:id="tablaDetalles" VBox.vgrow="ALWAYS">
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
        <columns>
            <TableColumn fx:id="colProducto" text="Producto" prefWidth="220"/>
            <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="90"/>
            <TableColumn fx:id="colPrecio" text="Precio ($)" prefWidth="100"/>
            <TableColumn fx:id="colSubtotal" text="Subtotal ($)" prefWidth="110"/>
        </columns>
    </TableView>
</VBox>