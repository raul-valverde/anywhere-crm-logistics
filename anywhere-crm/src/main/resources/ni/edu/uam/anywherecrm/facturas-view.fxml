<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import ni.edu.uam.anywherecrm.ui.DynamicIslandNav?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml"
            fx:controller="ni.edu.uam.anywherecrm.controller.FacturasController"
            stylesheets="@styles.css" styleClass="app-shell"
            prefWidth="1280" prefHeight="800">

    <!-- Capa base: contenido del módulo (se anima con FadeTransition al navegar) -->
    <ScrollPane fitToWidth="true" fitToHeight="true" focusTraversable="false" styleClass="content-scroll, content-layer">
        <VBox styleClass="module-root" spacing="16">

            <!-- Encabezado -->
            <VBox spacing="2" styleClass="module-header">
                <Label text="Menú principal  ›  Facturas" styleClass="breadcrumb"/>
                <Label text="Facturas" styleClass="screen-title"/>
                <Label text="Historial de ventas facturadas y comprobantes en PDF" styleClass="screen-subtitle"/>
            </VBox>

            <!-- Acciones -->
            <HBox styleClass="card" spacing="10" alignment="CENTER_LEFT">
                <VBox spacing="2">
                    <Label text="Listado de facturas" styleClass="section-title"/>
                    <Label text="Selecciona una factura para ver sus productos o generar su PDF" styleClass="section-caption"/>
                </VBox>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Actualizar" onAction="#cargarFacturas"/>
                <Button text="Generar PDF" onAction="#handleGenerarPdf" styleClass="btn-primary"/>
            </HBox>

            <!-- Listado: altura para 6 filas completas (38 cabecera + 6 x 34) -->
            <TableView fx:id="tablaFacturas" VBox.vgrow="ALWAYS" prefHeight="300" minHeight="250">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colId" text="N.º" prefWidth="50"/>
                    <TableColumn fx:id="colFecha" text="Fecha" prefWidth="100"/>
                    <TableColumn fx:id="colCliente" text="Cliente" prefWidth="200"/>
                    <TableColumn fx:id="colVendedor" text="Vendedor" prefWidth="120"/>
                    <TableColumn fx:id="colTotal" text="Total ($)" prefWidth="100"/>
                    <TableColumn fx:id="colEstado" text="Estado" prefWidth="100"/>
                </columns>
            </TableView>

            <VBox spacing="2">
                <Label text="Productos de la factura" styleClass="section-title"/>
                <Label text="Detalle de la factura seleccionada" styleClass="section-caption"/>
            </VBox>
            <TableView fx:id="tablaDetalles" VBox.vgrow="ALWAYS" prefHeight="230" minHeight="180">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colProducto" text="Producto" prefWidth="220"/>
                    <TableColumn fx:id="colCantidad" text="Cantidad" prefWidth="90"/>
                    <TableColumn fx:id="colPrecio" text="Precio ($)" prefWidth="100"/>
                    <TableColumn fx:id="colSubtotal" text="Subtotal ($)" prefWidth="110"/>
                </columns>
            </TableView>
        </VBox>
    </ScrollPane>

    <!-- Capa flotante: Isla Dinámica (no captura clics fuera de la cápsula) -->
    <DynamicIslandNav activo="FACTURAS"/>
</StackPane>
